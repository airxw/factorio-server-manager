{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GlobalAsset",
  "description": "系统管理员维护的全局基础资产/模板契约",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "全局资产唯一标识"
    },
    "type": {
      "type": "string",
      "enum": ["COMMODITY", "TEMPLATE", "RULE"],
      "description": "资产类型：商品/文案模板/规则"
    },
    "name": {
      "type": "string",
      "description": "默认显示名称"
    },
    "default_price": {
      "type": "number",
      "minimum": 0,
      "description": "默认价格（如果是商品）"
    },
    "execution_logic": {
      "type": "string",
      "description": "底层执行逻辑，如 RCON 指令。支持变量如 {player_id}"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "系统级别是否启用该资产"
    },
    "game_pack_id": {
      "type": "string",
      "description": "所属游戏 Pack 标识"
    }
  },
  "required": ["id", "type", "name", "is_active"]
}