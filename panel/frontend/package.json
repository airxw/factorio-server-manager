{
  "name": "@gameserver-panel/frontend",
  "version": "4.32.4",
  "private": true,
  "description": "GameServer Panel 4.15.0 — Panel 前端（React 19 + Vite 6 + TypeScript）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:release": "npm run typecheck && npm run build && npm run verify",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:coverage:utils": "COVERAGE_SCOPE=utils vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:prod": "E2E_BASE_URL=https://gsp.ecsrz.com:3001 playwright test",
    "build:analyze": "ANALYZE=1 npm run build",
    "verify": "node -e \"const fs=require('fs');const path='dist';const banned=['localhost:3000','127.0.0.1:3000'];let found=false;function check(p){const s=fs.readFileSync(p,'utf8');banned.forEach(b=>{if(s.includes(b)){console.error('ERROR: Found banned string \"'+b+'\" in '+p);found=true;}});}function walk(p){fs.readdirSync(p).forEach(f=>{const fp=p+'/'+f;if(fs.statSync(fp).isDirectory())walk(fp);else check(fp);});}walk(path);if(found)process.exit(1);console.log('✅ Build verification passed');\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json,md}\""
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.0",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.1",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwind-merge": "^2.6.1",
    "tw-animate-css": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^25.0.1",
    "msw": "^2.14.6",
    "prettier": "^3.9.5",
    "rollup-plugin-visualizer": "^5.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  },
  "browserslist": [
    "Chrome >= 90",
    "Firefox >= 88",
    "Safari >= 14",
    "Edge >= 90",
    "iOS >= 14",
    "ChromeAndroid >= 90"
  ]
}
