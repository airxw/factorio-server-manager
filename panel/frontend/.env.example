# ============================================================================
# GameServer Panel 前端环境变量样例 — 四.10
# 复制为 .env.local 进行本地覆盖；.env.development / .env.production 为模式默认值
# 仅 VITE_ 前缀变量会暴露到前端代码（切勿放入密钥）
# ============================================================================

# REST API / WebSocket 基址
# - 留空：开发走 Vite proxy，生产走同源
# - 显式设置：用于前后端独立部署或自定义域名（严禁在生产使用 localhost:3000）
VITE_API_BASE=

# 演示账号（demo 登录）入口可见性
# - true：登录页底部展示"点击直接登录"按钮，自动用 admin@local.dev / admin123 登录
# - false：完全隐藏 demo 入口，避免在公网部署中暴露管理员凭据
# 默认行为：开发模式（vite dev）下视为 true，生产构建（vite build）下视为 false
# 即非生产默认开启，生产需显式打开；建议公网部署保持关闭
VITE_ENABLE_DEMO=false
