{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.frontend.tsbuildinfo",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "baseUrl": "../..",
    "paths": {
      "@public/*": ["public/*"],
      "@/*": ["panel/frontend/src/*"]
    }
  },
  "include": ["src/**/*", "vite.config.ts", "../../public/schema/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
