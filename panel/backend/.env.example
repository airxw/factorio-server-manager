# ============================================================================
# Panel Backend 环境变量（本地开发用，复制自 public/config_template/panel.env.template）
# 生产环境请通过环境变量注入，不要提交真实密钥
# ============================================================================

# 运行环境（development/production，影响错误响应详细度与日志级别）
NODE_ENV=development

# Panel 后端监听端口（spec §3.2 约定 3000）
PORT=3000

# JWT 签名密钥（生产环境必须替换为强随机值，至少 32 字符）
JWT_SECRET=dev-secret-please-change-in-production-min32chars!!

# JWT 最小密钥长度（默认 16，生产环境建议 32）
JWT_MIN_SECRET_LENGTH=16

# CORS 允许来源（逗号分隔多域名，生产环境应替换为实际前端域名）
CORS_ORIGIN=http://localhost:5173

# 数据库连接字符串（P0 使用 SQLite，零配置）
# v4.20.0: 可在 /setup 向导内切换 SQLite/MySQL/PostgreSQL（向导内测试连接 + 写入 .env + 自动重启）
#   - SQLite: ./data/panel.db（相对 panel/backend/ 目录）
#   - MySQL:  mysql://user:password@host:3306/database
#   - PostgreSQL: postgresql://user:password@host:5432/database
DATABASE_URL=./data/panel.db

# Daemon 节点 URL（P0 单机模式，Panel+Daemon 同机；8080 对公网禁用，仅 Panel 本机调用）
# v4.20.0: 可在 /setup 向导内添加 Daemon 节点（首个节点 FQDN 自动写入此字段）
#   单机模式可在向导内勾选"暂不配置 Daemon"留空此字段
DAEMON_URL=http://localhost:8080

# Daemon 鉴权 Token（与 daemon.env.template 中 DAEMON_TOKEN 保持一致）
DAEMON_TOKEN=

# master Panel 对外公开地址（slave 节点通过此地址访问 master，用于生成 slave 启动命令）
# 生产环境默认公网 HTTPS（符合 rules 0.md）；局域网部署可改为 https://192.168.5.23:3001
# v4.20.0: 可在 /setup 向导内填写（向导实时校验 HTTPS 协议，http:// 标 warn 不阻塞）
PUBLIC_BASE_URL=https://gsp.ecsrz.com:3001

# Pack 加载目录（包含 5 款内置 pack：minecraft/factorio/palworld/ark/rust）
PACKS_DIR=../../packs

# 实例运行目录（每个实例在此目录下以 id 为子目录）
INSTANCES_DIR=../../instances

# 密码强度策略（v3.9.0-S3 + 模块3_用户安全）
# zxcvbn 评分下限（0-4，默认 3；v3.9.0-S3 注册接口要求 score >= 2，此处为改密更严格策略）
PASSWORD_MIN_ZXCVBN_SCORE=3
# 密码历史防重用条数（改密时与最近 N 条 bcrypt 比对，命中则拒绝）
PASSWORD_MAX_HISTORY=5

# 日志级别（trace/debug/info/warn/error，生产环境建议 info）
LOG_LEVEL=info

# v4.0.2: 演示模式（VITE_ENABLE_DEMO 必须与前端 .env.production 保持一致）
#   - true：后端启动时自动 seed 5 个游戏实例（演示数据）；登录页可一键登录演示账号
#   - false：默认（无 demo 数据）
# 注意：这是一个故意保留的安全风险开关——公网部署开启后将暴露 admin/manager/user 三个 *@local.dev 账号
VITE_ENABLE_DEMO=false

# v4.13.0 步骤18b: Daemon 上报玩家会话鉴权密钥
# 必须与 daemon/.env 中 DAEMON_REPORT_KEY 保持一致；留空则 Panel 拒绝所有上报请求
DAEMON_REPORT_KEY=
