{
  "name": "@gameserver-panel/backend",
  "version": "4.32.4",
  "private": true,
  "description": "GameServer Panel 4.15.0 — Panel 后端（Express + Knex + SQLite + JWT + WS）",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "npx --node-options=\"--import tsx\" knex migrate:latest --knexfile src/db/knexfile.ts",
    "migrate:rollback": "npx --node-options=\"--import tsx\" knex migrate:rollback --knexfile src/db/knexfile.ts",
    "migrate:make": "npx --node-options=\"--import tsx\" knex migrate:make --knexfile src/db/knexfile.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/multer": "^2.2.0",
    "@types/zxcvbn": "^4.4.5",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "cron-parser": "^5.6.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "sqlite3": "^5.1.7",
    "ua-parser-js": "^2.0.10",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "zxcvbn": "^4.4.2"
  },
  "optionalDependencies": {
    "mysql2": "^3.11.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/sqlite3": "^3.1.11",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.5.12",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "supertest": "^7.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
