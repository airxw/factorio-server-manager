# ============================================================================
# Daemon 环境变量模板
# 依据：spec §3.9 — 环境变量 + .env 文件，无硬编码
# 用途：daemon/.env 的模板，复制后填入实际值
# ============================================================================

# Daemon 监听端口（8080 对公网禁用，仅 Panel 本机调用）
PORT=8080

# Daemon 鉴权 Token（与 panel.env.template 中 DAEMON_TOKEN 保持一致）
DAEMON_TOKEN=

# 实例运行目录（每个实例在此目录下以 id 为子目录）
INSTANCES_DIR=./instances

# 日志级别（trace/debug/info/warn/error，生产环境建议 info）
LOG_LEVEL=info

# 日志文件大小上限（字节，默认 10485760 即 10MB）
LOG_FILE_MAX_SIZE=10485760

# 保留日志文件数量（默认 5）
LOG_FILES_TO_KEEP=5

# ============================================================================
# v4.13.0 步骤18b: 玩家会话上报配置
# ============================================================================
# Panel API 地址（daemon 通过此地址上报玩家 join/leave 事件到 player_sessions 表）
# 单机模式：http://localhost:3002（Panel 内部端口，见 rules 0.md）
PANEL_API_URL=http://localhost:3002

# 上报密钥（必须与 panel.env.template 中 DAEMON_REPORT_KEY 保持一致）
# 留空则禁用玩家会话上报功能（daemon 降级为 no-op，不影响主流程）
DAEMON_REPORT_KEY=
