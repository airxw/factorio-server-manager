{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FrontendRoutingConfig",
  "type": "object",
  "properties": {
    "defaultView": {
      "type": "string",
      "enum": ["admin", "store", "guild"],
      "default": "store",
      "description": "新用户登录后的默认落地页视图"
    },
    "viewPermissions": {
      "type": "object",
      "properties": {
        "admin": { "type": "array", "items": { "type": "string" }, "default": ["super_admin"] },
        "guild": { "type": "array", "items": { "type": "string" }, "default": ["super_admin", "guild_master"] },
        "store": { "type": "array", "items": { "type": "string" }, "default": ["*"] }
      },
      "description": "各视图的RBAC访问控制权限要求"
    }
  },
  "required": ["defaultView", "viewPermissions"]
}
