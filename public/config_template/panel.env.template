# ============================================================================
# Panel Backend 环境变量模板
# 依据：spec §3.9 — 环境变量 + .env 文件，无硬编码
# 用途：panel/backend/.env 的模板，复制后填入实际值
# ============================================================================

# Panel 后端监听端口（spec §3.2 约定 3000）
PORT=3000

# JWT 签名密钥（生产环境必须替换为强随机值，至少 32 字符）
JWT_SECRET=

# JWT 最小密钥长度（默认 16，生产环境建议 32）
JWT_MIN_SECRET_LENGTH=16

# CORS 允许来源（逗号分隔多域名，生产环境应替换为实际前端域名）
CORS_ORIGIN=http://localhost:5173

# 数据库连接字符串（P0 使用 SQLite，零配置）
DATABASE_URL=./data/panel.db

# Daemon 节点 URL（P0 单机模式，Panel+Daemon 同机；8080 对公网禁用，仅 Panel 本机调用）
DAEMON_URL=http://localhost:8080

# Daemon 鉴权 Token（与 daemon.env.template 中 DAEMON_TOKEN 保持一致）
DAEMON_TOKEN=

# 日志级别（trace/debug/info/warn/error，生产环境建议 info）
LOG_LEVEL=info

# ============================================================================
# 系统更新与诊断配置（v3.4.0 新增）
# ============================================================================

# 更新源类型：tar（蓝绿 tar 包，主路径） / git（git pull，可选）
UPDATE_SOURCE_TYPE=tar

# 更新清单 URL（GitHub Releases API；tar 模式生效）
UPDATE_MANIFEST_URL=https://api.github.com/repos/airxw/gameserver-panel/releases/latest

# git 模式分支名 / tar 模式 target_commitish 校验
UPDATE_BRANCH=main

# 蓝绿部署根目录（含 current/ next/ previous/ shared/）
DEPLOY_ROOT=/opt/gameserver-panel

# 进程管理器：systemd / pm2 / none
PROCESS_MANAGER=systemd

# 冒烟测试端口（避开 8080，8080 禁外网）
SMOKE_TEST_PORT=9090

# 改密安全策略
PASSWORD_MIN_ZXCVBN_SCORE=3
PASSWORD_MAX_HISTORY=5

# ============================================================================
# v4.13.0 步骤18b: 玩家会话上报接收端点配置
# ============================================================================
# Daemon 上报玩家 join/leave 事件的鉴权密钥
# 必须与 daemon.env.template 中 DAEMON_REPORT_KEY 保持一致
# 留空则 Panel 拒绝所有上报请求（端点返回 403），daemon 侧也会因未配置而降级为 no-op
DAEMON_REPORT_KEY=
