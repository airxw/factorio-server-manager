{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ServerInstance",
  "type": "object",
  "properties": {
    "id": { "type": "string", "description": "全局唯一实例ID" },
    "nodeId": { "type": "string", "description": "所属Daemon节点ID (Admin视图依赖)" },
    "packId": { "type": "string", "description": "关联的游戏Pack ID" },
    "status": { 
      "type": "string", 
      "enum": ["running", "stopped", "deploying", "error"],
      "description": "统一三值状态灯" 
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "云原生标签，如 ['env:prod', 'game:palworld'] (Admin视图筛选依赖)"
    },
    "metrics": {
      "type": "object",
      "properties": {
        "cpu": { "type": "number" },
        "memory": { "type": "number" },
        "players": { "type": "integer" }
      },
      "description": "轻量级轮询指标 (Store/Guild视图依赖)"
    }
  },
  "required": ["id", "nodeId", "packId", "status"]
}
