{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gameserver-panel/public/schema/vote-records-schema.json",
  "title": "Vote Records Schema",
  "description": "vote_records 表数据契约。投票明细表，记录每个投票的参与者选择。来源：scheme-final-merged.md §4.2.2 P3。factorio 迁移表。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1,
      "description": "主键，自增整数"
    },
    "vote_id": {
      "type": "integer",
      "minimum": 1,
      "description": "投票 ID，引用 votes.id (integer)"
    },
    "voter": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-zA-Z0-9_-]{1,32}$",
      "description": "投票参与者游戏内玩家名。UNIQUE(vote_id, voter) 防重复投票"
    },
    "vote_choice": {
      "type": "string",
      "enum": ["yes", "no"],
      "description": "投票选择：yes=赞成；no=反对"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "投票时间（ISO 8601 字符串）"
    }
  },
  "required": ["id", "vote_id", "voter", "vote_choice", "created_at"]
}
