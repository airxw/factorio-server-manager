{
  "name": "@gameserver-panel/daemon",
  "version": "4.32.4",
  "private": true,
  "description": "GameServer Panel 4.15.0 — Daemon 节点代理（Express + ws + Bearer Token 鉴权）",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "daemon": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@types/yauzl": "^3.4.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pino": "^9.3.2",
    "rcon-client": "^4.2.4",
    "ws": "^8.18.0",
    "yauzl": "^3.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "@vitest/coverage-v8": "^2.1.9",
    "js-yaml": "^5.2.1",
    "tsx": "^4.7.3",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
