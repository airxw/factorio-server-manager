# ============================================================================
# Daemon 环境变量模板
# 依据：spec §3.9 — 环境变量 + .env 文件，无硬编码
# 用途：复制为 .env 后填入实际值（cp .env.example .env）
# 源：public/config_template/daemon.env.template
# ============================================================================

# Daemon 监听端口（8080 对公网禁用，仅 Panel 本机调用）
PORT=8080

# Daemon 实例 ID（多节点部署时唯一标识本节点；单机模式可留空，默认 'local-node'）
DAEMON_ID=local-node

# Daemon 鉴权 Token（与 panel.env.template 中 DAEMON_TOKEN 保持一致）
DAEMON_TOKEN=

# 实例运行目录（每个实例在此目录下以 id 为子目录）
INSTANCES_DIR=./instances

# 监控采样间隔（毫秒，默认 60000 即 1 分钟；CPU/Mem/Disk 采集周期）
MONITOR_INTERVAL_MS=60000

# 日志级别（trace/debug/info/warn/error，生产环境建议 info）
LOG_LEVEL=info

# v4.13.0 步骤18b: 玩家会话上报配置
# Panel API 地址（单机模式：http://localhost:3002，Panel 内部端口）
PANEL_API_URL=http://localhost:3002
# 上报密钥（必须与 panel/backend/.env 中 DAEMON_REPORT_KEY 保持一致；留空则禁用上报）
DAEMON_REPORT_KEY=
